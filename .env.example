NODE_ENV=production
WEB_HOST=127.0.0.1
WEB_PORT=3000
PUBLIC_BASE_URL=https://mail.llab.so
INVITE_SENDER_EMAIL=info@llab.so
POP3_HOST=0.0.0.0
POP3_PORT=995
SMTP_HOST=0.0.0.0
SMTP_PORT=587
TLS_CERT_PATH=/etc/letsencrypt/live/mail.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/mail.example.com/privkey.pem
DATABASE_URL=postgresql://llab_mail:replace-with-db-password@127.0.0.1:5433/llab_mail
DATABASE_SSL=false

# Generate each with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-random-hex-characters
APP_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Used to sign in to the dashboard. Prefer ADMIN_PASSWORD_HASH in production.
# Generate a hash with: npm run hash-password -- "your password" (or see README)
ADMIN_PASSWORD=change-me-now
# ADMIN_PASSWORD_HASH=$2b$12$...

# Only use true for local protocol testing. Production requires valid TLS files.
ALLOW_INSECURE_LOCAL=false
